<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/inputSceneName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="场景名称"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true" />

    <EditText
        android:id="@+id/inputSceneDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="时长"
        android:inputType="number"
        android:maxLines="1"
        android:singleLine="true" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupDurationUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUnitMinutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分钟"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUnitSeconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="秒"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="结束时"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFinishAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="静音"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRingtone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="铃声"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
