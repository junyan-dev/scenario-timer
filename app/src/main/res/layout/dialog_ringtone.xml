<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_ringtone_dialog">

    <!-- Ring animation indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/fill_secondary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="40sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="定时器结束"
        android:textSize="20sp"
        android:textColor="@color/label_primary"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="铃声正在播放"
        android:textSize="15sp"
        android:textColor="@color/label_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopRingtone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="停止铃声"
        android:textAllCaps="false"
        app:cornerRadius="14dp"
        app:backgroundTint="@color/system_red"
        app:elevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
